---
import "../index.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tshomo Studios",
  description = "Tshomo Studios is a video game and animation studio in Johannesburg, South Africa, creating afrofuturistic worlds through interactive entertainment.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tshomo Studios" />
    <meta
      property="og:title"
      content="Tshomo Studios | Afrofuturistic Game & Animation"
    />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@TshomoStudios" />
    <meta
      name="twitter:title"
      content="Tshomo Studios | Afrofuturistic Game & Animation"
    />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
